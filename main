   if(start==1)
    {
        in_it(B);
    }
    else if(start==2)
    {
        load_game(B,dim);
        load_turn(turn);
    }
    else
      {

      system("cls");
        cout<<" invalid commmand "<<endl;
            game=0;
    }

while(game)
{
    ofstream write("board.txt");
   if(write.is_open())
   {

    for(int i=0;i<dim*dim;i++)
    {  char temp=' ';
    char  tempi='_';
    if(B[i]==temp)
    {
        write<<tempi;
    }
    else{
        write<<B[i];
    }

    }
    write.close();
   }
   else
   {
       cout<<" file not opened";
   }
    ofstream w("turn.txt");
    if (w.is_open()) {
        w << turn;
        w.close();
    } else {
        cout << "Error saving turn";
    }
    print_array(B);
    print_board(dim);
   ask_for_move(r,c,ri,ci,score,scorei,B,turn,dim);

change_turn(turn);

  system("cls");
  wincheck(B,dim,game);

}
    return 0;
}
