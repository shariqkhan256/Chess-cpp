void load_game(char B[], int dim) {
    char temp = '_';
    char tempi = ' ';
    char k;
    ifstream read("board.txt");

    if (!read.is_open()) {
        cout << "Error in file";
    } else {
        for (int i = 0; i < dim * dim; i++) {
            read >> k;

            if (k == temp)
                {
                   k=tempi;
                }
            else {
                    k=k;
                }
            B[i] = k;
        }
    }
    read.close();
}

void load_turn(bool &turn)
{

    ifstream r("turn.txt");
    if (r.is_open()) {
        r >> turn;
        r.close();
    } else {
        cout << "Error loading turn";
    }
}
